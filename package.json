{
  "name": "bocaditos-blw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && vite build --config vite.server.config.ts",
    "start": "node --disable-warning=ExperimentalWarning dist-server/index.js",
    "start:demo": "node --disable-warning=ExperimentalWarning dist-server/index.js --seed-demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  },
  "description": "PWA para el seguimiento de la alimentación complementaria con BLW",
  "engines": {
    "node": ">=22.18"
  }
}
