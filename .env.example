# Configuración de Bocaditos BLW para Docker.
# Copia este archivo como .env y ajusta los valores. El .env no se sube a Git,
# así que `git pull` nunca lo pisa.

# Puerto en el que se abre la app: http://IP-del-NAS:PUERTO
PORT=8080

# true  = rellena con datos de ejemplo al CREAR la base de datos (para probar)
# false = empieza vacía (uso real)
SEED_DEMO_DATA=false

# Zona horaria
TZ=Europe/Madrid

# Dónde se guarda la base de datos (bocaditos.db):
#   ./data          carpeta "data" junto a este archivo (recomendado en un NAS:
#                   entra en sus copias de seguridad). Antes del primer arranque:
#                   mkdir -p data && sudo chown -R 1000:1000 data
#   bocaditos_data  volumen interno de Docker
DATA_PATH=./data
